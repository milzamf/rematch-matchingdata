APP_NAME=RE-MATCH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Set DB_HOST=db when using Docker, or 127.0.0.1 for local)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rematch
DB_USERNAME=rematch
DB_PASSWORD=rematch_secret

# Session & Authentication
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173

# Dev Roles & Default Password
BATCHMATCH_DEV_ROLE=user
BATCHMATCH_DEV_USER_PASSWORD=password
BATCHMATCH_DEV_ADMIN_PASSWORD=password
BATCHMATCH_DEV_PIMPINAN_PASSWORD=password

# AI Configuration
REMATCH_AI_ENABLED=false
REMATCH_AI_PROVIDER=tabitoken
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TABITOKEN_API_KEY=
TABITOKEN_BASE_URL=https://tabitoken.com/v1
REMATCH_AI_MODEL=
REMATCH_AI_TIMEOUT=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Meilisearch Configuration (Set MEILISEARCH_HOST=http://meilisearch:7700 for Docker, or http://127.0.0.1:7700 for local)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=rematch_meili_master_key
